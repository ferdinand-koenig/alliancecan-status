<Window x:Class="AllianceStatus.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AllianceStatus.Views"
        Title="Alliance Status"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Keeps the native frame so Windows 11 draws rounded corners and a shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="OuterBorder" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0">
        <Grid x:Name="Root">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Grid.RenderTransform>

            <!-- ========== Overview ========== -->
            <DockPanel x:Name="MainPage">
                <Grid DockPanel.Dock="Top" Margin="16,12,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"/>
                            <TextBlock Text="Alliance Status" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,1"/>
                        </StackPanel>
                        <TextBlock x:Name="Subtitle" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   Margin="16,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource IconButton}"
                            ToolTip="Refresh now" Click="Refresh_Click">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshSpin"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Settings"
                            Click="Settings_Click" Margin="2,0,0,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/>
                    </Button>
                </Grid>

                <Border x:Name="FooterPanel" DockPanel.Dock="Bottom" Background="{DynamicResource Footer}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="16,8,14,9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="status.alliancecan.ca"
                                Click="Website_Click" VerticalAlignment="Center" ToolTip="Open the status website"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="FooterWarn" Style="{StaticResource Glyph}" FontSize="12" Text="&#xE7BA;"
                                       Foreground="{DynamicResource Caution}" Margin="0,0,6,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="FooterText" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <ScrollViewer x:Name="IncidentScroll" MaxHeight="460" Padding="12,0,10,6"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="IncidentList" Focusable="False">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type v:SectionRow}">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" Margin="4,4,0,6"/>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type v:IncidentRow}">
                                    <Button Style="{StaticResource CardButton}" Click="Incident_Click"
                                            Opacity="{Binding Opacity}" ToolTip="{Binding Url}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding Stripe}" CornerRadius="1.5"/>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource Chip}"
                                                            CornerRadius="4" Padding="6,1,6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Cluster}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Badge}" Foreground="{Binding Stripe}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding When}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding ScheduleVisibility}">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding Schedule}" FontSize="12" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Visibility="{Binding SummaryVisibility}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="50" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyState" Margin="24,18,24,28" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Grid Width="44" Height="44" HorizontalAlignment="Center">
                            <Ellipse x:Name="EmptyGlyphBg" Opacity="0.16"/>
                            <TextBlock x:Name="EmptyGlyph" Style="{StaticResource Glyph}" FontSize="20"/>
                        </Grid>
                        <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="EmptyBody" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="290" Margin="0,4,0,0"/>
                        <Button x:Name="EmptyAction" Style="{StaticResource AccentButton}" Content="Choose clusters"
                                Click="Settings_Click" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- ========== Settings ========== -->
            <DockPanel x:Name="SettingsPage" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,12,16,6">
                    <Button Style="{StaticResource IconButton}" ToolTip="Back" Click="Back_Click">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;"/>
                    </Button>
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,1"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Divider}"
                        BorderThickness="0,1,0,0" Padding="16,8,14,9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Quit"
                                Click="Quit_Click" VerticalAlignment="Center" ToolTip="Stop monitoring and close"/>
                        <TextBlock x:Name="CreditsText" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,0,14,14">
                        <TextBlock Text="Clusters" Style="{StaticResource SectionTitle}" Margin="2,6,0,2"/>
                        <TextBlock x:Name="DiscoveryText" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   Margin="2,0,0,8" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="4">
                            <ItemsControl x:Name="ClusterList" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Check}" Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="Other feeds" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="CustomList" Focusable="False" Margin="0,0,0,4" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,5,4,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                    ToolTip="Remove feed" Tag="{Binding}" Click="RemoveCustom_Click">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11"/>
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomUrl" Style="{StaticResource Field}" Tag="Paste an RSS or Atom feed URL"
                                     KeyDown="CustomUrl_KeyDown"/>
                            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource AccentButton}" Content="Add feed"
                                    Margin="8,0,0,0" Click="AddCustom_Click"/>
                        </Grid>
                        <TextBlock x:Name="CustomMessage" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9,12,10">
                            <DockPanel>
                                <CheckBox x:Name="AutostartToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Checked="Autostart_Changed" Unchecked="Autostart_Changed"
                                          AutomationProperties.Name="Start with Windows"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows"/>
                                    <TextBlock Text="Opens quietly in the notification area when you sign in"
                                               FontSize="12" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="2,10,0,0"
                                   Text="Feeds are checked at startup and every 30 minutes. Finished incidents stay listed for 7 days."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
